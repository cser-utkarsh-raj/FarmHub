# FarmHub Backend Configuration
ENVIRONMENT=development
PROJECT_NAME="FarmHub API"
API_V1_STR="/api"

# Security & Tokens
# Set SECRET_KEY in the deployment environment to a unique 32+ character random value.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite file; For PostgreSQL use: postgresql://user:password@localhost:5432/farmhub)
DATABASE_URL=sqlite:///./farmhub.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Weather API (Open-Meteo is open access, no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_SECONDS=3600

# data.gov.in / AGMARKNET resource used for Bihar mandi prices.
# Never commit the real credential. The ML CLI has the public sample/demo key as a local fallback;
# production/CI must override this with DATA_GOV_IN_API_KEY in the runtime secret store.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# Server-to-server key for POST /market/ingest.
# Generate a strong random value and keep it only in deployment secrets.
MANDI_INGESTION_KEY=

# ML model artifact path. The artifact is generated by backend/ml/scripts/train.py and is not committed to Git.
FARMHUB_ML_MODEL_PATH=./backend/ml/models/price_forecaster.joblib

# Official Data.gov.in agricultural resources
# One DATA_GOV_IN_API_KEY is used for all four resources.
DATA_GOV_IN_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_VARIETY_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
DATA_GOV_IN_RAINFALL_RESOURCE_ID=6c05cd1b-ed59-40c2-bc31-e314f39c6971
DATA_GOV_IN_PRODUCTION_RESOURCE_ID=35be999b-0208-4354-b557-f6ca9a5355de
